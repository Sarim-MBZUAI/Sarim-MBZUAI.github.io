---
// Self-hosted visit tracker: reports each page view to the Cloudflare Worker in visit-tracker/.
// Rendered inside <head> by Layout.astro, early so even very short visits are recorded.
interface Props {
  endpoint: string;
}
const { endpoint } = Astro.props;
const visitTrackerEndpoint = endpoint.replace(/\/+$/, '');
---

<script define:vars={{ visitTrackerEndpoint }}>
  (function () {
    var params = new URLSearchParams(location.search);
    try {
      /* Browsers that have signed in to the /visitors dashboard (yours) are not counted. */
      if (localStorage.getItem("visit-tracker-ignore") === "1") return;
    } catch (e) {}
    if (!navigator.sendBeacon || navigator.webdriver) return;

    var id = window.crypto && crypto.randomUUID ? crypto.randomUUID() : Date.now().toString(36) + Math.random().toString(36).slice(2);
    function send(path, data) {
      try {
        navigator.sendBeacon(visitTrackerEndpoint + path, JSON.stringify(data));
      } catch (e) {}
    }

    send("/hit", {
      id: id,
      path: location.pathname,
      title: document.title,
      ref: document.referrer,
      utm: params.get("utm_source"),
      screen: screen.width + "x" + screen.height,
      lang: navigator.language,
    });

    /* Report how long the page was actually on screen whenever the visitor switches away or leaves. */
    var visibleMs = 0;
    var shownAt = document.visibilityState === "visible" ? Date.now() : 0;
    document.addEventListener("visibilitychange", function () {
      if (document.visibilityState === "hidden") {
        if (shownAt) visibleMs += Date.now() - shownAt;
        shownAt = 0;
        send("/leave", { id: id, seconds: Math.round(visibleMs / 1000) });
      } else {
        shownAt = Date.now();
      }
    });
  })();
</script>
